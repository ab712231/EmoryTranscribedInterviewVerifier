# Not edited by hand. From the repository root:
#
#   python scripts/deployment/web_env.py --env dev
#
# writes web/.env.local with these three values, read from the deployed stacks.
# Use --env prod for the live deployment. This file only documents which values
# the website needs.
#
# The address the website is served from must also appear in
# infra/config/<env>.json under allowedOrigins, or every API call fails CORS.

VITE_API_BASE_URL=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=
